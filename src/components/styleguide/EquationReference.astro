---
/**
 * A reference to a numbered equation in prose: the markup the posts' maths pipeline will write for
 * \eqref, or for \Cref with `long`.
 *
 * @param to the equation's anchor, e.g. eq-lorenz
 * @param number the equation's number
 * @param long lead with the function icon and the word "Equation", for a reference that starts or
 *   carries a sentence
 * @param class extra classes, e.g. a static state such as is-focus
 */
import FunctionIcon from 'rk-ui/icons/function.svg'

interface Props {
  to: string
  number: number
  long?: boolean
  class?: string
}

const { to, number, long = false, class: className } = Astro.props
---

<a class:list={['rk-eqref', className]} href={`#${to}`}
  >{long && <FunctionIcon class="rk-icon" aria-hidden="true" />}{long && 'Equation '}<span>(</span>{number}<span>)</span></a
>
