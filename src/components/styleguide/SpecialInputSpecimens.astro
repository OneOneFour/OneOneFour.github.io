---
/**
 * The special input types (file, date and time, search, number, colour, range with ticks and the
 * plain text-like types), each in its states. Lettered variants are options for Gate 1b.
 *
 * @param theme the panel's theme, used to keep ids unique across the two panels
 */
import Specimen from './Specimen.astro'
import SpecimenRow from './SpecimenRow.astro'
import DownloadIcon from 'rk-ui/icons/download-simple.svg'
import SearchIcon from 'rk-ui/icons/magnifying-glass.svg'

interface Props {
  theme: 'light' | 'dark'
}

const { theme } = Astro.props
const SEARCH_STATES = [
  { label: 'rest', class: '' },
  { label: 'with a value (hover or focus it for the clear button)', class: '', value: 'Query' },
  { label: 'focused', class: 'is-focus', value: 'Query' },
  { label: 'disabled', class: '', disabled: true },
]
const DATE_TYPES = ['date', 'time', 'month', 'week', 'datetime-local'] as const
const DROP_STATES = [
  { label: "rest: click or drop a file (the name isn't shown without a script)" },
  { label: 'hover', class: 'is-hover' },
  { label: 'focused', class: 'is-focus' },
  { label: 'disabled', disabled: true },
  { label: 'error', invalid: true },
]
---

<SpecimenRow title="File A: button and filename">
  <Specimen label="rest" wide>
    <input class="rk-input" type="file" aria-label="Specimen" />
  </Specimen>
  <Specimen label="hover" wide>
    <input class="rk-input is-hover" type="file" aria-label="Specimen" />
  </Specimen>
  <Specimen label="pressed" wide>
    <input class="rk-input is-active" type="file" aria-label="Specimen" />
  </Specimen>
  <Specimen label="focused" wide>
    <input class="rk-input is-focus" type="file" aria-label="Specimen" />
  </Specimen>
  <Specimen label="multiple" wide>
    <input class="rk-input" type="file" aria-label="Specimen" multiple />
  </Specimen>
  <Specimen label="disabled" wide>
    <input class="rk-input" type="file" aria-label="Specimen" disabled />
  </Specimen>
  <Specimen label="error" wide>
    <div class="rk-field">
      <label for={`${theme}-file-error`}>Label</label>
      <input
        class="rk-input"
        id={`${theme}-file-error`}
        type="file"
        aria-invalid="true"
        aria-describedby={`${theme}-file-error-message`}
      />
      <span class="rk-field-message rk-field-message--error" id={`${theme}-file-error-message`}>Error message</span>
    </div>
  </Specimen>
</SpecimenRow>

<SpecimenRow title="File B: drop panel">
  {
    DROP_STATES.map((state) => (
      <Specimen label={state.label} wide>
        <label class:list={['rk-file-drop', state.class]}>
          <input type="file" disabled={state.disabled} aria-invalid={state.invalid ? 'true' : undefined} />
          <DownloadIcon class="rk-icon" aria-hidden="true" />
          <span>Choose a file or drop it here</span>
        </label>
      </Specimen>
    ))
  }
</SpecimenRow>

<SpecimenRow title="Date and time">
  {
    DATE_TYPES.map((type) => (
      <Specimen label={type === 'date' ? "date (the popup and Firefox's icon are the browser's own)" : type} wide>
        <input class="rk-input" type={type} aria-label="Specimen" />
      </Specimen>
    ))
  }
  <Specimen label="focused (the focused part of a real focus fills yellow)" wide>
    <input class="rk-input is-focus" type="date" aria-label="Specimen" value="2026-11-01" />
  </Specimen>
  <Specimen label="disabled" wide>
    <input class="rk-input" type="date" aria-label="Specimen" value="2026-11-01" disabled />
  </Specimen>
  <Specimen label="error" wide>
    <input class="rk-input" type="time" aria-label="Specimen" value="09:30" aria-invalid="true" />
  </Specimen>
</SpecimenRow>

<SpecimenRow title="Search A: icon inside">
  {
    SEARCH_STATES.map((state) => (
      <Specimen label={state.label} wide>
        <div class="rk-search">
          <input
            class:list={['rk-input', state.class]}
            type="search"
            aria-label="Search"
            placeholder="Search"
            value={state.value}
            disabled={state.disabled}
          />
        </div>
      </Specimen>
    ))
  }
</SpecimenRow>

<SpecimenRow title="Search B: attached button">
  {
    SEARCH_STATES.map((state) => (
      <Specimen label={state.label} wide>
        <form class="rk-search-bar" role="search">
          <input
            class:list={['rk-input', state.class]}
            type="search"
            aria-label="Search"
            placeholder="Search"
            value={state.value}
            disabled={state.disabled}
          />
          <button class="rk-button" type="submit" disabled={state.disabled}>
            <SearchIcon class="rk-icon rk-icon--small" aria-hidden="true" />
            Search
          </button>
        </form>
      </Specimen>
    ))
  }
</SpecimenRow>
