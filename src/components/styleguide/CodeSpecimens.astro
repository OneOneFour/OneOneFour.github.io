---
/**
 * Code blocks with live copy buttons: the default box and the editor tab, then both on the greige
 * slate, with inline code in a sentence.
 */
import CodeBlock from '../CodeBlock.astro'
import Specimen from './Specimen.astro'
import SpecimenRow from './SpecimenRow.astro'
import { LORENZ_JS, LORENZ_PYTHON } from './code-samples'

const BOXES = [
  { title: 'Code block', class: undefined },
  { title: 'Editor tab (.rk-code--tab)', class: 'rk-code--tab' },
]
---

{
  BOXES.map((box) => (
    <SpecimenRow title={box.title}>
      <Specimen label="Python, with caption" wide>
        <CodeBlock code={LORENZ_PYTHON} lang="python" label="Python" class={box.class} />
      </Specimen>
      <Specimen label="JavaScript (no logo), long lines scroll" wide>
        <CodeBlock code={LORENZ_JS} lang="javascript" label="JavaScript" class={box.class} />
      </Specimen>
      <Specimen label="Julia, accented logo" wide>
        <CodeBlock code="σ, ρ, β = 10.0, 28.0, 8 / 3" lang="julia" label="Julia" class={box.class} />
      </Specimen>
      <Specimen label="no caption" wide>
        <CodeBlock code="x = lorenz(1.0, 1.0, 1.0)" lang="python" class={box.class} />
      </Specimen>
    </SpecimenRow>
  ))
}

<SpecimenRow title="Greige slate (.rk-slate-greige)">
  <Specimen label="default box" wide>
    <CodeBlock code={LORENZ_PYTHON} lang="python" label="Python" class="rk-slate-greige" />
  </Specimen>
  <Specimen label="editor tab" wide>
    <CodeBlock code={LORENZ_PYTHON} lang="python" label="Python" class="rk-slate-greige rk-code--tab" />
  </Specimen>
  <Specimen label="inline code" wide>
    <p class="rk-slate-greige">
      Call <code>lorenz(x, y, z)</code> for the derivatives, then <code>step(state, dt)</code> once per frame
      with <code>Δt = 0.01</code>.
    </p>
  </Specimen>
</SpecimenRow>
