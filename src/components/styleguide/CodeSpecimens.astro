---
/**
 * Code blocks with live copy buttons: the default box in each language with a logo, the editor
 * tab, the greige slate, and inline code in a sentence.
 */
import CodeBlock from '../CodeBlock.astro'
import Specimen from './Specimen.astro'
import SpecimenRow from './SpecimenRow.astro'
import { LORENZ_PYTHON } from './code-samples'
---

<SpecimenRow title="Code block">
  <Specimen label="Python, with caption" wide>
    <CodeBlock code={LORENZ_PYTHON} lang="python" label="Python" />
  </Specimen>
  <Specimen label="Julia" wide>
    <CodeBlock code="σ, ρ, β = 10.0, 28.0, 8 / 3" lang="julia" label="Julia" />
  </Specimen>
  <Specimen label="Fortran" wide>
    <CodeBlock code="real :: sigma = 10.0, rho = 28.0" lang="fortran-free-form" label="Fortran" />
  </Specimen>
  <Specimen label="C++" wide>
    <CodeBlock code="double sigma = 10.0, rho = 28.0;" lang="cpp" label="C++" />
  </Specimen>
  <Specimen label="Markdown (wide mark)" wide>
    <CodeBlock code="**β ≈ 0.3** in the [paper](#)" lang="markdown" label="Markdown" />
  </Specimen>
  <Specimen label="no caption" wide>
    <CodeBlock code="x = lorenz(1.0, 1.0, 1.0)" lang="python" />
  </Specimen>
</SpecimenRow>

<SpecimenRow title="Editor tab (.rk-code--tab)">
  <Specimen label="Python, with caption" wide>
    <CodeBlock code={LORENZ_PYTHON} lang="python" label="Python" class="rk-code--tab" />
  </Specimen>
  <Specimen label="no caption" wide>
    <CodeBlock code="x = lorenz(1.0, 1.0, 1.0)" lang="python" class="rk-code--tab" />
  </Specimen>
</SpecimenRow>

<SpecimenRow title="Greige slate (.rk-slate-greige)">
  <Specimen label="default box" wide>
    <CodeBlock code={LORENZ_PYTHON} lang="python" label="Python" class="rk-slate-greige" />
  </Specimen>
  <Specimen label="inline code" wide>
    <p class="rk-slate-greige">
      Call <code>lorenz(x, y, z)</code> for the derivatives, then <code>step(state, dt)</code> once per frame
      with <code>Δt = 0.01</code>.
    </p>
  </Specimen>
</SpecimenRow>
