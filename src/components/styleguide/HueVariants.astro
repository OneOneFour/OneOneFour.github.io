---
import '../../styles/tokens-candidates.css'
import candidatesCss from '../../styles/tokens-candidates.css?raw'
import { parseTokens } from '../../../scripts/check-contrast.mjs'
import { contrast, grade, hexOf, tokens, type Contrast, type Theme } from './colour-tokens'

/**
 * Each proposed -deep and -tint token next to its alternates from tokens-candidates.css, as
 * link text on --surface and --raised (-deep) or a panel of --fg text (-tint).
 *
 * @param theme the theme the hex values and ratios are computed for
 */
interface Props {
  theme: Theme
}

const { theme } = Astro.props

const candidates: Map<string, string> = parseTokens(candidatesCss)
const allTokens = new Map([...tokens, ...candidates])

/** Proposed tokens with alternates, e.g. `--teal-deep`, in the order the candidates file lists them. */
const proposed = [...new Set([...candidates.keys()].map((name) => name.replace(/-alt\d+$/, '')))]

/** The options for one proposed token: itself as "current", then each alternate. */
function optionsFor(base: string) {
  const alternates = [...candidates.keys()].filter((name) => name.startsWith(`${base}-alt`))
  return [
    { label: 'current', name: base },
    ...alternates.map((name) => ({ label: name.slice(base.length + 1), name })),
  ]
}

const ratio = ({ ratio }: Contrast) => `${ratio.toFixed(2)} ${grade(ratio)}`
---

{
  proposed.map((base) => (
    <>
      <h3>{base.slice(2)}</h3>
      <div class="options">
        {optionsFor(base).map(({ label, name }) => (
          <div class="option" style={`--sample: var(${name})`}>
            <p class="option-name">
              <strong>
                {base.slice(2)} {label}
              </strong>
              {hexOf(allTokens, name, theme)}
            </p>

            {base.endsWith('-deep') && (
              <>
                <p class="on-surface">
                  Sphinx of black quartz, <span class="link">judge my vow</span>.
                  <small>on --surface {ratio(contrast(allTokens, name, '--surface', theme))}</small>
                </p>
                <p class="on-raised">
                  Sphinx of black quartz, <span class="link">judge my vow</span>.
                  <small>on --raised {ratio(contrast(allTokens, name, '--raised', theme))}</small>
                </p>
              </>
            )}

            {base === '--coral-deep' && theme === 'light' && (
              <p>
                <span class="button-sample">Button</span>
                <small>--on-coral {ratio(contrast(allTokens, '--on-coral', name, theme))}</small>
              </p>
            )}

            {base.endsWith('-tint') && (
              <p class="tint-panel">
                Pack my box with five dozen liquor jugs.
                <small>--fg {ratio(contrast(allTokens, '--fg', name, theme))}</small>
              </p>
            )}
          </div>
        ))}
      </div>
    </>
  ))
}

<style>
  h3 {
    margin-block: var(--space-5) var(--space-3);
    font-size: var(--step-1);
  }

  .options {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
    gap: var(--space-4);
  }

  .option p {
    margin-block: 0 var(--space-2);
  }

  .option small {
    display: block;
    color: var(--muted);
    font-size: var(--step--1);
    font-variant-numeric: tabular-nums;
  }

  .option-name {
    display: grid;
    font-variant-numeric: tabular-nums;
  }

  .on-raised,
  .tint-panel {
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius);
  }

  .on-raised {
    background: var(--raised);
  }

  .tint-panel {
    background: var(--sample);
    color: var(--fg);
  }

  .tint-panel small {
    color: inherit;
  }

  .link {
    color: var(--sample);
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  .button-sample {
    display: inline-block;
    margin-block-end: var(--space-1);
    padding: var(--space-1) var(--space-4);
    border: var(--outline-width) solid var(--line);
    border-radius: var(--radius);
    background: var(--sample);
    box-shadow: var(--shadow);
    color: var(--on-coral);
    font-weight: 600;
  }
</style>
