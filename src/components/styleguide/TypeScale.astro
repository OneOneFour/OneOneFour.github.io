---
/** The same heading and body stack at each candidate --type-ratio, side by side. */

const RATIOS = ['1.25', '1.28', '1.3']

const HEADINGS = [
  { role: 'h1', step: 4, text: 'Sphinx of black quartz' },
  { role: 'h2', step: 3, text: 'Judge my vow' },
  { role: 'h3', step: 2, text: 'Pack my box with five dozen jugs' },
  { role: 'h4', step: 1, text: 'The quick brown fox jumps' },
]

/** The size of a step at a ratio, e.g. "1.563rem / 25px" (the scale starts at 1rem = 16px). */
function size(ratio: string, step: number): string {
  const rem = Number(ratio) ** step
  return `${Number(rem.toFixed(3))}rem / ${Math.round(rem * 16)}px`
}
---

<div class="scales">
  {
    RATIOS.map((ratio) => (
      <div class="rk-type-scale" style={`--type-ratio: ${ratio}`}>
        <p class="ratio">{ratio}</p>
        {HEADINGS.map(({ role, step, text }) => (
          <>
            <p class="size">
              {role} · step {step} · {size(ratio, step)}
            </p>
            <p class="heading" style={`font-size: var(--step-${step})`}>
              {text}
            </p>
          </>
        ))}
        <p class="size">body · step 0 · {size(ratio, 0)}</p>
        <p class="body">
          Pack my box with five dozen liquor jugs. The quick brown fox jumps over the lazy dog.
          Sphinx of black quartz, judge my vow. How vexingly quick daft zebras jump.
        </p>
        <p class="size">small · step -1 · {size(ratio, -1)}</p>
        <p class="small">Bright vixens jump; dozy fowl quack. Waltz, bad nymph, for quick jigs vex.</p>
      </div>
    ))
  }
</div>

<style>
  .scales {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    gap: var(--space-6);
  }

  p {
    margin: 0;
  }

  /* The labels use fixed sizes, not steps, so they match in every column. */
  .ratio {
    margin-block-end: var(--space-3);
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 800;
  }

  .size {
    margin-block-start: var(--space-4);
    color: var(--muted);
    font-size: 0.8125rem;
    font-variant-numeric: tabular-nums;
  }

  .heading {
    font-family: var(--font-display);
    font-weight: 800;
    line-height: var(--line-height-heading);
  }

  .body {
    font-size: var(--step-0);
    line-height: var(--line-height-body);
  }

  .small {
    font-size: var(--step--1);
    line-height: var(--line-height-body);
  }
</style>
