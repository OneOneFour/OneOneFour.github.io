---
/** The heading and body stack on the type scale, with each step's size. */
import typeCss from 'rk-ui/type.css?raw'
import { parseTokens } from '../../../scripts/check-contrast.mjs'

const typeTokens = parseTokens(typeCss)
const ratio = Number(typeTokens.get('--type-ratio'))
const smallRem = parseFloat(typeTokens.get('--step--1') ?? '')

const HEADINGS = [
  { role: 'h1', step: 4, text: 'Sphinx of black quartz' },
  { role: 'h2', step: 3, text: 'Judge my vow' },
  { role: 'h3', step: 2, text: 'Pack my box with five dozen jugs' },
  { role: 'h4', step: 1, text: 'The quick brown fox jumps' },
]

/** A size in rem as e.g. "1.69rem / 27px" (1rem = 16px). */
function format(rem: number): string {
  return `${Number(rem.toFixed(3))}rem / ${Number((rem * 16).toFixed(1))}px`
}

/** The size of a step on the scale; step -1 is fixed in type.css rather than on the ratio. */
function size(step: number): string {
  return format(step === -1 ? smallRem : ratio ** step)
}
---

<div class="scale">
  <p class="size">--type-ratio: {ratio}</p>
  {
    HEADINGS.map(({ role, step, text }) => (
      <>
        <p class="size">
          {role} · step {step} · {size(step)}
        </p>
        <p class="heading" style={`font-size: var(--step-${step})`}>
          {text}
        </p>
      </>
    ))
  }
  <p class="size">body · step 0 · {size(0)}</p>
  <p class="body">
    Pack my box with five dozen liquor jugs. The quick brown fox jumps over the lazy dog. Sphinx of
    black quartz, judge my vow. How vexingly quick daft zebras jump.
  </p>
  <p class="size">small · step -1 · {size(-1)}</p>
  <p class="small">Bright vixens jump; dozy fowl quack. Waltz, bad nymph, for quick jigs vex.</p>
</div>

<style>
  p {
    margin: 0;
  }

  .size {
    margin-block-start: var(--space-4);
    color: var(--muted);
    font-size: var(--step--1);
    font-variant-numeric: tabular-nums;
  }

  .heading {
    font-family: var(--font-display);
    font-weight: 800;
    line-height: var(--line-height-heading);
  }

  .body {
    font-size: var(--step-0);
    line-height: var(--line-height-body);
  }

  .small {
    font-size: var(--step--1);
    line-height: var(--line-height-body);
  }
</style>
