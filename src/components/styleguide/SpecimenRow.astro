---
/**
 * A titled row of styleguide examples (Specimens) that wraps on narrow screens.
 *
 * @param title the row's heading
 */
interface Props {
  title: string
}

const { title } = Astro.props
---

<h3>{title}</h3>
<div class="row"><slot /></div>

<style>
  h3 {
    margin-block: var(--space-5) var(--space-3);
    font-size: var(--step-0);
  }

  .row {
    display: flex;
    flex-wrap: wrap;
    align-items: start;
    gap: var(--space-5);
  }
</style>
