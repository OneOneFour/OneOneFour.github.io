---
/**
 * Small multiples: one panel per series on a shared scale, each showing its series in colour
 * over the others in grey.
 *
 * @param x the x value of every point, shared by all series
 * @param series the series, one panel each, coloured in series order
 * @param toon the toon option: ink edges on the coloured lines
 */
import ChartAxes from './ChartAxes.astro'
import { linear, linePath, niceTicks } from './chart-scale'
import type { Series } from './chart-data'

interface Props {
  x: number[]
  series: Series[]
  toon?: boolean
}

const { x: xs, series, toon = false } = Astro.props
const width = 240
const height = 140
const plot = { left: 32, top: 8, right: width - 20, bottom: height - 28 }
const values = series.flatMap((s) => s.values)
const yTicks = niceTicks(Math.min(...values), Math.max(...values), 3)
const y = linear([yTicks[0], yTicks.at(-1)!], [plot.bottom, plot.top])
const x = linear([xs[0], xs.at(-1)!], [plot.left, plot.right])
const xTicks = [xs[0], xs.at(-1)!].map((v) => ({ at: x(v), label: String(v) }))
const paths = series.map((s) => linePath(s.values.map((v, i) => [x(xs[i]), y(v)])))
---

<div class="rk-chart-multiples">
  {
    series.map((s, i) => (
      <div>
        <p class="rk-chart-title">{s.name}</p>
        <svg
          class:list={['rk-chart', { 'rk-chart--toon': toon }]}
          width={width}
          height={height}
          viewBox={`0 0 ${width} ${height}`}
          role="img"
          aria-label={`${s.name} against the other series`}
        >
          <ChartAxes plot={plot} yTicks={yTicks} y={y} xTicks={xTicks} />
          {paths.map((d, j) => j !== i && <path class="rk-chart-line rk-chart-series-context" d={d} />)}
          <g class={`rk-chart-series-${i + 1}`}>
            <path class="rk-chart-casing" d={paths[i]} />
            <path class="rk-chart-line" d={paths[i]} />
          </g>
        </svg>
      </div>
    ))
  }
</div>
