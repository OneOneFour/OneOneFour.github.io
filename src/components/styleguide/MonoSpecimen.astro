---
/** JetBrains Mono: code with ligatures, a widget readout, maths symbols and look-alikes. */
import { LORENZ_PYTHON } from './code-samples'

const READOUT = 'σ = 10.00  ρ = 28.00  β = 2.667'
---

<div class="mono">
  <pre><code>{LORENZ_PYTHON}</code></pre>
  <p class="lookalikes">0O 1lI rn m {'{}'} [] () =&gt; -&gt; != == &lt;= &gt;=</p>
  <p class="readout">{READOUT}</p>
  <p class="symbols">≈ ≠ ≤ ≥ ± × ÷ − → ← ∞ ∂ ∇ ∑ ∫ √ ∝ ° ′ ″</p>
  <p><em># italic: σ, ρ and β stay fixed while Δt varies</em></p>
</div>

<style>
  .mono {
    font-family: var(--font-mono);
  }

  p {
    margin-block: var(--space-3) 0;
  }

  pre {
    margin: 0;
    padding: var(--space-4);
    overflow-x: auto;
    border-radius: var(--radius);
    background: var(--slate);
    color: var(--fg);
    font-size: var(--step--1);
    line-height: var(--line-height-body);
  }

  /* Monospace elements get the browser's monospace by default; take --font-mono instead. */
  pre,
  code {
    font-family: inherit;
  }

  .readout {
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius);
    background: var(--raised);
    font-size: var(--step-1);
    white-space: pre-wrap;
  }

  .symbols {
    font-size: var(--step-1);
    word-spacing: 0.2em;
  }

  .lookalikes {
    font-size: var(--step-3);
    word-spacing: 0.3em;
  }
</style>
