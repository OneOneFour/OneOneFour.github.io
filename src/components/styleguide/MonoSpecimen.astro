---
/**
 * JetBrains Mono: the same code with ligatures on and off, a widget readout, maths symbols and
 * look-alikes.
 */

const LIGATURE_SETTINGS = [
  { label: 'Ligatures on (default)', ligatures: true },
  { label: 'Ligatures off', ligatures: false },
]

const CODE = `def lorenz(x, y, z, σ=10.0, ρ=28.0, β=8 / 3) -> tuple:
    """Return (dx/dt, dy/dt, dz/dt) for the Lorenz system."""
    # σ: Prandtl number, ρ: Rayleigh number
    return σ * (y - x), x * (ρ - z) - y, x * y - β * z

Δt = 0.01  # step size
if Δt != 0 and Δt <= 0.1:
    steps = {"n": 1000, "Δt": Δt}`

const READOUT = 'σ = 10.00  ρ = 28.00  β = 2.667'
---

<div class="mono">
  <div class="settings">
    {
      LIGATURE_SETTINGS.map(({ label, ligatures }) => (
        <div class:list={['setting', { 'no-ligatures': !ligatures }]}>
          <h3>{label}</h3>
          <pre><code>{CODE}</code></pre>
          <p class="lookalikes">0O 1lI rn m {'{}'} [] () =&gt; -&gt; != == &lt;= &gt;=</p>
        </div>
      ))
    }
  </div>
  <p class="readout">{READOUT}</p>
  <p class="symbols">≈ ≠ ≤ ≥ ± × ÷ − → ← ∞ ∂ ∇ ∑ ∫ √ ∝ ° ′ ″</p>
  <p><em># italic: σ, ρ and β stay fixed while Δt varies</em></p>
</div>

<style>
  .mono {
    font-family: var(--font-mono);
  }

  .settings {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 30rem), 1fr));
    gap: var(--space-5);
  }

  .setting {
    min-width: 0;
  }

  .no-ligatures {
    font-variant-ligatures: none;
  }

  h3 {
    margin-block: 0 var(--space-3);
    font-family: var(--font-display);
    font-size: var(--step-1);
  }

  p {
    margin-block: var(--space-3) 0;
  }

  pre {
    margin: 0;
    padding: var(--space-4);
    overflow-x: auto;
    border-radius: var(--radius);
    background: var(--lilac-tint);
    color: var(--fg);
    font-size: var(--step--1);
    line-height: var(--line-height-body);
  }

  /* Monospace elements get the browser's monospace by default; take --font-mono instead. */
  pre,
  code {
    font-family: inherit;
  }

  .readout {
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius);
    background: var(--raised);
    font-size: var(--step-1);
    white-space: pre-wrap;
  }

  .symbols {
    font-size: var(--step-1);
    word-spacing: 0.2em;
  }

  .lookalikes {
    font-size: var(--step-3);
    word-spacing: 0.3em;
  }
</style>
