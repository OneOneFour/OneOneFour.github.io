---
import Swatch from './Swatch.astro'
import { paletteTokens, type Theme } from './colour-tokens'

/**
 * The page palettes side by side: each one's page with text, a card and a code panel on it, and
 * its --surface and --raised swatches.
 *
 * @param theme the theme the hex values and ratios are computed for
 */
interface Props {
  theme: Theme
}

const { theme } = Astro.props
---

<h3>Page palettes</h3>
<p class="caption">Set data-palette on &lt;html&gt; or any container. Cream is the default.</p>
<div class="palettes">
  {
    [...paletteTokens].map(([palette, tokens]) => (
      <section class="palette" data-palette={palette}>
        <h4>{palette}</h4>
        <p>
          Page text <span class="muted">and muted text</span>
        </p>
        <div class="rk-card">
          <p>On a raised card</p>
        </div>
        <pre><code>x = "on slate"</code></pre>
        <div class="swatches">
          <Swatch tokens={tokens} name="--surface" theme={theme} />
          <Swatch tokens={tokens} name="--raised" theme={theme} />
        </div>
      </section>
    ))
  }
</div>

<style>
  h3 {
    margin-block: var(--space-5) var(--space-3);
    font-size: var(--step-1);
  }

  .caption,
  .muted {
    color: var(--muted);
  }

  .caption {
    margin-block: calc(-1 * var(--space-2)) var(--space-3);
    font-size: var(--step--1);
  }

  .palettes {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 12rem), 1fr));
    gap: var(--space-4);
  }

  .palette {
    display: grid;
    align-content: start;
    gap: var(--space-3);
    padding: var(--space-4);
    border: 1px solid var(--muted);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--fg);
  }

  .palette > * {
    margin: 0;
  }

  h4 {
    font-size: var(--step-0);
    text-transform: capitalize;
  }

  .rk-card {
    padding: var(--space-3);
  }

  .rk-card p {
    margin: 0;
  }

  .swatches {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(6rem, 1fr));
    gap: var(--space-3);
  }
</style>
