---
/** The chart colours: the series in their fixed order, and the sequential and diverging scales. */
import Specimen from './Specimen.astro'
import SpecimenRow from './SpecimenRow.astro'
import { DIVERGING, SEQUENTIAL } from './chart-scale'

const SERIES = ['teal', 'yellow', 'navy', 'green', 'sky', 'coral', 'grape', 'tangerine']
---

<SpecimenRow title="Series, in order (--chart-1 to --chart-8)">
  <Specimen label="neighbours stay apart for colour-blind readers; scatter plots use the first three" wide>
    <ol class="steps">
      {
        SERIES.map((hue, i) => (
          <li>
            <span class="chip" style={`background: var(--chart-${i + 1})`} />
            {i + 1} {hue}
          </li>
        ))
      }
    </ol>
  </Specimen>
</SpecimenRow>

<SpecimenRow title="Scales">
  <Specimen label="sequential (--seq-1 to --seq-5): magnitude" wide>
    <ol class="steps">
      {SEQUENTIAL.map((step) => <li><span class="chip" style={`background: var(${step})`} />{step}</li>)}
    </ol>
  </Specimen>
  <Specimen label="diverging (--div-cold-3 to --div-warm-3): anomalies, neutral in the middle" wide>
    <ol class="steps">
      {DIVERGING.map((step) => <li><span class="chip" style={`background: var(${step})`} />{step}</li>)}
    </ol>
  </Specimen>
</SpecimenRow>

<style>
  .steps {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    font-size: var(--step--1);
    list-style: none;
  }

  li {
    display: grid;
    justify-items: start;
    gap: var(--space-1);
  }

  .chip {
    inline-size: 4.5rem;
    block-size: 2rem;
    border-radius: calc(var(--radius) / 2);
  }
</style>
