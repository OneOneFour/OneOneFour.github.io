---
/**
 * What base.css styles besides headings, which the type scale shows: links in each state, code,
 * highlights and selection.
 */
import Specimen from './Specimen.astro'
import SpecimenRow from './SpecimenRow.astro'
---

<SpecimenRow title="Links">
  <Specimen label="rest"><a href="#specimen-link">A text link</a></Specimen>
  <Specimen label="hover"><a href="#specimen-link" class="is-hover">A text link</a></Specimen>
  <Specimen label="focused (marker pen)"><a href="#specimen-link" class="is-focus">A text link</a></Specimen>
  <Specimen label="in running text" wide>
    <p>
      The quick brown fox <a href="#specimen-link">jumps over the lazy dog</a> and keeps on running until the line
      wraps, so the <a href="#specimen-link" class="is-focus">focused marker carries across the line break</a> too.
    </p>
  </Specimen>
</SpecimenRow>

<SpecimenRow title="Code, highlights and selection">
  <Specimen label="inline code" wide>
    <p>Call <code>step(state, dt)</code> once per frame; select this text to see the selection colour.</p>
  </Specimen>
  <Specimen label="pre" wide>
    <pre><code>{`def step(x, dt):
    return x + dt * f(x)  # σ = 10, β ≈ 8/3`}</code></pre>
  </Specimen>
  <Specimen label="mark" wide>
    <p>The quick brown fox <mark>jumps over the lazy dog</mark> and keeps on running.</p>
  </Specimen>
</SpecimenRow>
