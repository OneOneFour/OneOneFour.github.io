---
/** Static boxes for the shape, outline, shadow and focus tokens. The live versions are the components. */
import Specimen from './Specimen.astro'
import SpecimenRow from './SpecimenRow.astro'

const BOXES = [
  { class: 'panel', label: 'Panel', caption: '--radius, no outline (static)' },
  { class: 'outlined', label: 'Resting', caption: '--outline-width, --shadow' },
  { class: 'outlined hover', label: 'Hover', caption: 'lifted by --lift-offset onto --shadow-hover' },
  { class: 'outlined pressed', label: 'Pressed', caption: 'moved by --press-offset onto --shadow-pressed' },
  { class: 'outlined pill', label: 'Pill', caption: '--radius-pill' },
  { class: 'unfilled', label: 'Unfilled', caption: '--line-unfilled, flush' },
  { class: 'unfilled inset', label: 'Inset', caption: '--shadow-inset (unfilled, pressed)' },
  { class: 'outlined focused', label: 'Focused', caption: '--focus-width band of --focus, no shadow' },
]
---

<SpecimenRow title="Shape and shadow tokens">
  {
    BOXES.map((box) => (
      <Specimen label={box.caption}>
        <div class:list={['box', box.class]}>{box.label}</div>
      </Specimen>
    ))
  }
</SpecimenRow>

<style>
  .box {
    padding: var(--space-3) var(--space-4);
    border: var(--outline-width) solid transparent;
    border-radius: var(--radius);
    font-weight: 600;
  }

  .panel {
    background: var(--raised);
  }

  .outlined {
    border-color: var(--line);
    background: var(--teal);
    box-shadow: var(--shadow);
    color: var(--on-fill);
  }

  .hover {
    box-shadow: var(--shadow-hover);
    translate: calc(-1 * var(--lift-offset-x)) calc(-1 * var(--lift-offset-y));
  }

  .pressed {
    box-shadow: var(--shadow-pressed);
    translate: var(--press-offset-x) var(--press-offset-y);
  }

  .pill {
    border-radius: var(--radius-pill);
    background: var(--yellow);
  }

  .unfilled {
    border-color: var(--line-unfilled);
  }

  .inset {
    background: var(--raised);
    box-shadow: var(--shadow-inset);
  }

  .focused {
    outline: var(--focus-width) solid var(--focus);
    outline-offset: var(--focus-offset);
    box-shadow: none;
  }
</style>
