---
/** The toast and flush top bars, each at the top of a small page and in place rather than stuck. */
import Specimen from './Specimen.astro'
import BackToTop from '../BackToTop.astro'
import Button from '../ui/Button.astro'

const SPECIMEN_TEXT =
  'Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.'
const VARIANTS = [
  { label: '.rk-topbar--toast (the default)', class: 'rk-topbar--toast' },
  { label: ".rk-topbar--flush, for full-width headers such as an article's title", class: 'rk-topbar--flush' },
]
---

{
  VARIANTS.map((variant) => (
    <Specimen label={variant.label} wide>
      <div class="page">
        <div class:list={['rk-topbar', variant.class]}>
          <Button>Button</Button>
          <BackToTop />
        </div>
        <p>{SPECIMEN_TEXT}</p>
      </div>
    </Specimen>
  ))
}

<style>
  .page {
    overflow: clip;
    border: 1px solid var(--muted);
    border-radius: var(--radius);
  }

  .page .rk-topbar {
    position: static;
  }

  /* Shown as they look once the page has scrolled. */
  .page .rk-topbar,
  .page :global(.rk-back-to-top) {
    animation: none;
  }

  p {
    margin: var(--space-4);
  }
</style>
