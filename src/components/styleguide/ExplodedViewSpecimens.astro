---
/**
 * Exploded views: a steam train of five assemblies in three looks, and a lamp that is one, both
 * drawn by ExplodedView from their data, with the subdued illustration colours.
 *
 * @param theme the panel's theme, passed on to keep ids unique
 */
import ExplodedView from './ExplodedView.astro'
import { ILLUSTRATION_COLOURS } from './exploded-view'
import Specimen from './Specimen.astro'
import SpecimenRow from './SpecimenRow.astro'
import { steamTrain } from './steam-train'
import { tableLamp } from './table-lamp'
import './illustration-tokens.css'

interface Props {
  theme: 'light' | 'dark'
}

const { theme } = Astro.props
---

<SpecimenRow title="Steam train: hover or focus an assembly to take it apart">
  <Specimen
    label="A: subdued (the default): flat at rest; apart on --ease-spring, home on --ease-snap; the switch pulls every assembly apart"
    wide
  >
    <div class="train"><ExplodedView illustration={steamTrain} theme={theme} /></div>
  </Specimen>
  <Specimen label="B: pop: the UI's fills, and each assembly casts the resting shadow" wide>
    <div class="train"><ExplodedView illustration={steamTrain} theme={theme} look="pop" /></div>
  </Specimen>
  <Specimen label="C: sticker: pop, with a glint keyline round each part and an edge round each assembly" wide>
    <div class="train"><ExplodedView illustration={steamTrain} theme={theme} look="sticker" /></div>
  </Specimen>
</SpecimenRow>

<SpecimenRow title="Lamp: the same parts, one assembly">
  <Specimen label="nearer parts rise further and cast longer shadows">
    <div class="lamp"><ExplodedView illustration={tableLamp} theme={theme} /></div>
  </Specimen>
</SpecimenRow>

<SpecimenRow title="Subdued illustration colours: four hues, three of them with one light or shade step">
  {
    ILLUSTRATION_COLOURS.map((colours) => (
      <Specimen label={colours.map((colour) => `--illustration-${colour}`).join(', ')}>
        <div class="steps">
          {colours.map((colour) => (
            <span class="step" style={`background: var(--illustration-${colour})`} />
          ))}
        </div>
      </Specimen>
    ))
  }
</SpecimenRow>

<style>
  .train {
    max-inline-size: 44rem;
  }

  .lamp {
    inline-size: 9rem;
  }

  .steps {
    display: flex;
    overflow: hidden;
    border: var(--outline-width) solid var(--line);
    border-radius: var(--radius);
  }

  .step {
    inline-size: 2.5rem;
    block-size: 2.5rem;
  }
</style>
