---
/**
 * A chart in a figure with its caption and source, and a static mock of a widget whose stage is
 * a chart, with the controls under it.
 *
 * @param theme the panel's theme, passed on to keep ids unique
 */
import LineChart from './LineChart.astro'
import LorenzWidgetMock from './LorenzWidgetMock.astro'
import Specimen from './Specimen.astro'
import SpecimenRow from './SpecimenRow.astro'
import { TIME_SERIES, YEARS } from './chart-data'
import './chart.css'

interface Props {
  theme: 'light' | 'dark'
}

const { theme } = Astro.props
---

<SpecimenRow title="Figure with caption and source (.rk-figure)">
  <Specimen label="toon chart" wide>
    <figure class="rk-figure">
      <LineChart x={YEARS} series={TIME_SERIES.slice(0, 3)} label="Three synthetic series" toon />
      <figcaption class="rk-figure-caption">
        <span class="rk-figure-label">Figure 1.</span> Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do
        eiusmod tempor incididunt ut labore.
        <span class="rk-figure-source">Source: synthetic data.</span>
      </figcaption>
    </figure>
  </Specimen>
</SpecimenRow>

<SpecimenRow title="Widget: a chart on the stage, controls under it (static mock)">
  <Specimen label="two trajectories from starts 10⁻³ apart; the live widget animates them" wide>
    <LorenzWidgetMock theme={theme} />
  </Specimen>
</SpecimenRow>
