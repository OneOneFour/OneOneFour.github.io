---
/**
 * Everything that shows waiting: the spinners, their sizes and labels, the progress bar and the
 * meter, filling buttons, the pending panel and the hopping-ball loader.
 */
import Button from '../ui/Button.astro'
import AtomIcon from 'rk-ui/icons/atom.svg'
import LightningIcon from 'rk-ui/icons/lightning.svg'
import StarIcon from 'rk-ui/icons/star.svg'
import Specimen from './Specimen.astro'
import SpecimenRow from './SpecimenRow.astro'

const DOT_SPINNERS = [
  { label: '.rk-spinner--triangle', class: 'rk-spinner--triangle' },
  { label: '.rk-spinner--dots.rk-spinner--squash', class: 'rk-spinner--dots rk-spinner--squash' },
  { label: '.rk-spinner--orbit (an alternate)', class: 'rk-spinner--orbit' },
]
const METERS = [
  { label: 'good (optimum range)', value: 0.3 },
  { label: 'middling', value: 0.7 },
  { label: 'bad', value: 0.92 },
]
const FILLS = [undefined, 'teal', 'navy', 'coral', 'grape'] as const
const LEVELS = [0.25, 0.5, 0.85]
const BALLS = [
  { label: 'teal (the default)' },
  { label: 'in coral', fill: 'coral' },
  { label: 'in grape', fill: 'grape' },
  { label: 'with an icon, in yellow', fill: 'yellow', Icon: StarIcon },
  { label: 'with an icon, in green', fill: 'green', Icon: AtomIcon },
  { label: 'with an icon, in navy', fill: 'navy', onFill: 'on-navy', Icon: LightningIcon },
]
---

<SpecimenRow title="Spinners">
  <Specimen label=".rk-spinner--ring">
    <span class="rk-spinner rk-spinner--ring" role="status">
      <span class="rk-visually-hidden">Loading…</span>
    </span>
  </Specimen>
  <Specimen label=".rk-spinner--dots">
    <span class="rk-spinner rk-spinner--dots" role="status">
      <span class="rk-spinner-dot"></span><span class="rk-spinner-dot"></span><span
        class="rk-spinner-dot"></span>
      <span class="rk-visually-hidden">Loading…</span>
    </span>
  </Specimen>
  <Specimen label=".rk-spinner--water, filling">
    <span class="rk-spinner rk-spinner--water" role="status">
      <span class="rk-water rk-water--rise" aria-hidden="true"></span>
      <span class="rk-visually-hidden">Loading…</span>
    </span>
  </Specimen>
  {
    DOT_SPINNERS.map((spinner) => (
      <Specimen label={spinner.label}>
        <span class:list={['rk-spinner', spinner.class]} role="status">
          <span class="rk-spinner-dot" />
          <span class="rk-spinner-dot" />
          <span class="rk-spinner-dot" />
          <span class="rk-visually-hidden">Loading…</span>
        </span>
      </Specimen>
    ))
  }
</SpecimenRow>

<SpecimenRow title="Spinner sizes and labels (--spinner-size, --spinner-fill)">
  <Specimen label="ring: small, with a visible label">
    <span class="loading" role="status">
      <span class="rk-spinner rk-spinner--ring" style="--spinner-size: 1.25rem" aria-hidden="true"
      ></span>
      Loading…
    </span>
  </Specimen>
  <Specimen label="ring: large, --spinner-fill set to teal">
    <span class="rk-spinner rk-spinner--ring" style="--spinner-size: 3rem; --spinner-fill: var(--teal)" role="status">
      <span class="rk-visually-hidden">Loading…</span>
    </span>
  </Specimen>
  <Specimen label="dots: small, with a visible label">
    <span class="loading" role="status">
      <span class="rk-spinner rk-spinner--dots" style="--spinner-size: 1.25rem" aria-hidden="true">
        <span class="rk-spinner-dot"></span><span class="rk-spinner-dot"></span><span
          class="rk-spinner-dot"></span>
      </span>
      Loading…
    </span>
  </Specimen>
  <Specimen label="water: large, --spinner-fill set to teal">
    <span class="rk-spinner rk-spinner--water" style="--spinner-size: 3rem; --spinner-fill: var(--teal)" role="status">
      <span class="rk-water rk-water--rise" aria-hidden="true"></span>
      <span class="rk-visually-hidden">Loading…</span>
    </span>
  </Specimen>
  <Specimen label="water: small, with a visible label">
    <span class="loading" role="status">
      <span class="rk-spinner rk-spinner--water" style="--spinner-size: 1.25rem" aria-hidden="true">
        <span class="rk-water rk-water--rise"></span>
      </span>
      Loading…
    </span>
  </Specimen>
  <Specimen label="triangle: large">
    <span class="rk-spinner rk-spinner--triangle" style="--spinner-size: 3rem" role="status">
      <span class="rk-spinner-dot"></span><span class="rk-spinner-dot"></span><span
        class="rk-spinner-dot"></span>
      <span class="rk-visually-hidden">Loading…</span>
    </span>
  </Specimen>
</SpecimenRow>

<SpecimenRow title="Progress bars">
  <Specimen label="striped (the default)" wide>
    <label class="rk-field">Label <progress class="rk-progress" max="100" value="65">65%</progress></label>
  </Specimen>
  <Specimen label="flat (.rk-progress--flat)" wide>
    <label class="rk-field">
      Label <progress class="rk-progress rk-progress--flat" max="100" value="40">40%</progress>
    </label>
  </Specimen>
  <Specimen label="striped, indeterminate (no value)" wide>
    <label class="rk-field">Label <progress class="rk-progress"></progress></label>
  </Specimen>
  <Specimen label="flat, indeterminate (no value)" wide>
    <label class="rk-field">Label <progress class="rk-progress rk-progress--flat"></progress></label>
  </Specimen>
</SpecimenRow>

<SpecimenRow title="Meter (a measurement, not progress)">
  {
    METERS.map((meter) => (
      <Specimen label={meter.label} wide>
        <label class="rk-field">
          Label
          <meter class="rk-meter" min="0" max="1" low="0.6" high="0.85" optimum="0.2" value={meter.value} />
        </label>
      </Specimen>
    ))
  }
</SpecimenRow>

<SpecimenRow title="Filling buttons (aria-busy, with an .rk-water child)">
  <Specimen label="filling: yellow, teal, navy, coral, grape">
    {
      FILLS.map((fill) => (
        <Button fill={fill} aria-busy="true" aria-disabled="true">
          <span class="rk-water rk-water--rise" aria-hidden="true" />
          Saving…
        </Button>
      ))
    }
  </Specimen>
  <Specimen label="set by --water-level: 0.25, 0.5, 0.85">
    {
      LEVELS.map((level) => (
        <Button fill="teal" aria-busy="true" aria-disabled="true" style={`--water-level: ${level}`}>
          <span class="rk-water" aria-hidden="true" />
          Uploading<span class="rk-visually-hidden"> {level * 100}%</span>
        </Button>
      ))
    }
  </Specimen>
  <Specimen label="not busy: the water is hidden">
    <Button fill="teal">
      <span class="rk-water" aria-hidden="true"></span>
      Upload
    </Button>
  </Specimen>
</SpecimenRow>

<SpecimenRow title="Pending panel (.rk-pending)">
  <Specimen label="filling up" wide>
    <div class="rk-pending" role="status">
      <span class="rk-water rk-water--rise" aria-hidden="true"></span>
      <p>Loading…</p>
    </div>
  </Specimen>
</SpecimenRow>

<SpecimenRow title="Hopping-ball loader: --loader-fill, --loader-on-fill and .rk-loader-ball">
  {
    BALLS.map(({ label, fill, onFill, Icon }) => (
      <Specimen label={label} wide>
        <div
          class="rk-loader rk-loader--hop"
          role="status"
          style={fill && `--loader-fill: var(--${fill})${onFill ? `; --loader-on-fill: var(--${onFill})` : ''}`}
        >
          {Icon && (
            <span class="rk-loader-ball">
              <Icon class="rk-icon" aria-hidden="true" />
            </span>
          )}
          <span class="rk-visually-hidden">Loading…</span>
        </div>
      </Specimen>
    ))
  }
</SpecimenRow>

<style>
  .loading {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }
</style>
