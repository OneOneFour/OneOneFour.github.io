---
import Swatch from './Swatch.astro'
import { colourGroups, tokens, tokensCss, type Theme } from './colour-tokens'
import { SUMMARY_NAMES } from './colour-summary'
import './chart-tokens.css'
import './illustration-tokens.css'

/**
 * The colour tokens the summary leaves out, from the package's tokens.css and the styleguide's
 * chart and illustration tokens, grouped as the files group them.
 *
 * @param theme the theme the hex values and ratios are computed for
 */
interface Props {
  theme: Theme
}

const { theme } = Astro.props
const groups = colourGroups(tokensCss)
  .map((group) => ({ ...group, names: group.names.filter((name) => !SUMMARY_NAMES.has(name)) }))
  .filter((group) => group.names.length > 0)
---

{
  groups.map((group) => (
    <>
      <h3>{group.title}</h3>
      {group.caption && <p class="caption">{group.caption}</p>}
      <div class="swatches">
        {group.names.map((name) => (
          <Swatch tokens={tokens} name={name} theme={theme} />
        ))}
      </div>
    </>
  ))
}

<style>
  h3 {
    margin-block: var(--space-5) var(--space-3);
    font-size: var(--step-1);
  }

  .caption {
    max-width: 65ch;
    margin-block: calc(-1 * var(--space-2)) var(--space-3);
    color: var(--muted);
    font-size: var(--step--1);
  }

  .swatches {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(8.5rem, 1fr));
    gap: var(--space-4);
  }
</style>
