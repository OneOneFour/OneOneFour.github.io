---
/**
 * Pagination, on page 2: A as folder tabs over the page's sheet, B as tiles between previous and
 * next buttons.
 */
import Specimen from './Specimen.astro'
import SpecimenRow from './SpecimenRow.astro'
import CaretLeftIcon from 'rk-ui/icons/caret-left.svg'
import CaretRightIcon from 'rk-ui/icons/caret-right.svg'

const PAGES = [1, 2, 3, null, 9]
const CURRENT = 2
const STATES = [
  { label: 'live', class: '' },
  { label: 'page 3 focused', class: 'is-focus' },
]
---

<SpecimenRow title="A: folder tabs">
  <Specimen label="index-card tabs" wide>
    <div class="rk-folder">
      <nav aria-label="Pagination">
        <ol class="rk-folder-tabs">
          <li>
            <a class="rk-folder-tab" href="#" rel="prev">
              <CaretLeftIcon class="rk-icon rk-icon--small" />
              <span class="rk-visually-hidden">Previous page</span>
            </a>
          </li>
          {PAGES.map((page) => (
            <li>
              {page === null ? (
                '…'
              ) : (
                <a class="rk-folder-tab" href="#" aria-current={page === CURRENT ? 'page' : undefined}>
                  {page}
                </a>
              )}
            </li>
          ))}
          <li>
            <a class="rk-folder-tab" href="#" rel="next">
              <CaretRightIcon class="rk-icon rk-icon--small" />
              <span class="rk-visually-hidden">Next page</span>
            </a>
          </li>
        </ol>
      </nav>
      <div class="rk-folder-sheet">
        <p>Page {CURRENT}</p>
      </div>
    </div>
  </Specimen>
</SpecimenRow>

<SpecimenRow title="B: tiles and buttons">
  {
    STATES.map((state) => (
      <Specimen label={state.label}>
        <nav class="rk-pagination" aria-label="Pagination">
          <a class="rk-button rk-button--small" href="#" rel="prev">
            <CaretLeftIcon class="rk-icon rk-icon--small" />
            Previous
          </a>
          <ol class="rk-tiles rk-tiles--compact">
            {PAGES.map((page) => (
              <li>
                {page === null ? (
                  '…'
                ) : (
                  <a
                    class:list={['rk-tile', page === 3 && state.class]}
                    href="#"
                    aria-current={page === CURRENT ? 'page' : undefined}
                  >
                    {page}
                  </a>
                )}
              </li>
            ))}
          </ol>
          <a class="rk-button rk-button--small" href="#" rel="next">
            Next
            <CaretRightIcon class="rk-icon rk-icon--small" />
          </a>
        </nav>
      </Specimen>
    ))
  }
</SpecimenRow>

<style>
  .rk-folder-sheet p {
    margin: 0;
  }
</style>
