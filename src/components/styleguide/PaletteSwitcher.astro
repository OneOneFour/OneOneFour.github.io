---
import { paletteTokens } from './colour-tokens'

/**
 * The styleguide's page palette switch: sets data-palette on <html> and remembers the choice
 * under `rk-palette`. SpecimenLayout applies the stored choice before first paint.
 */
const palettes = [...paletteTokens.keys()]
---

<fieldset class="rk-segmented palette-switcher">
  <legend class="rk-visually-hidden">Page palette</legend>
  {
    palettes.map((palette) => (
      <label>
        <input type="radio" name="rk-palette" value={palette} />
        {palette}
      </label>
    ))
  }
</fieldset>

<style>
  label {
    text-transform: capitalize;
  }
</style>

<script>
  const STORAGE_KEY = 'rk-palette'
  const root = document.documentElement
  const current = root.dataset.palette ?? 'cream'

  for (const radio of document.querySelectorAll<HTMLInputElement>('.palette-switcher input')) {
    radio.checked = radio.value === current
    radio.addEventListener('change', () => {
      root.dataset.palette = radio.value
      try {
        localStorage.setItem(STORAGE_KEY, radio.value)
      } catch {
        // Storage is blocked, so the choice lasts only until the page is left.
      }
    })
  }
</script>
