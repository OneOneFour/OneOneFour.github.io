---
/**
 * Folder tabs: live tabbed panels on a plain and a tinted sheet, the join with each tab selected,
 * and a tab's states.
 *
 * @param theme the panel's theme, used to keep ids unique across the two panels
 */
import Specimen from './Specimen.astro'
import SpecimenRow from './SpecimenRow.astro'

interface Props {
  theme: 'light' | 'dark'
}

const { theme } = Astro.props
const TABS = ['Tab one', 'Tab two', 'Tab three']
const SHEETS = [
  { key: 'plain', label: 'live, plain sheet', class: '' },
  { key: 'tinted', label: 'live, .rk-folder--tinted', class: 'rk-folder--tinted' },
]
const STATIC_TABS = ['One', 'Two', 'Three']

/** A static folder: which tab is selected, and optionally a state class on one tab */
interface StaticFolder {
  label: string
  selected: number
  tinted?: boolean
  state?: { tab: number; class: string }
}

const JOINS: StaticFolder[] = [
  { label: 'second tab selected', selected: 1 },
  { label: 'third tab selected', selected: 2 },
  { label: 'third tab selected, tinted', selected: 2, tinted: true },
]
const STATES: StaticFolder[] = [
  { label: 'second tab hover', selected: 0, state: { tab: 1, class: 'is-hover' } },
  { label: 'second tab pressed', selected: 0, state: { tab: 1, class: 'is-active' } },
  { label: 'second tab focused', selected: 0, state: { tab: 1, class: 'is-focus' } },
  { label: 'selected tab focused', selected: 0, state: { tab: 0, class: 'is-focus' } },
]
---

<SpecimenRow title="Live">
  {
    SHEETS.map((sheet) => {
      const id = `${theme}-folder-${sheet.key}`
      return (
        <Specimen label={sheet.label} wide>
          <rk-tabs class:list={['rk-folder', sheet.class]}>
            <div class="rk-folder-tabs rk-scroll" role="tablist" aria-label="Specimen">
              {TABS.map((name, i) => (
                <button
                  class="rk-folder-tab"
                  type="button"
                  role="tab"
                  id={`${id}-tab-${i}`}
                  aria-controls={`${id}-panel-${i}`}
                  aria-selected={i === 0 ? 'true' : 'false'}
                  tabindex={i === 0 ? undefined : -1}
                >
                  {name}
                </button>
              ))}
            </div>
            {TABS.map((name, i) => (
              <div
                class="rk-folder-sheet"
                role="tabpanel"
                id={`${id}-panel-${i}`}
                aria-labelledby={`${id}-tab-${i}`}
                tabindex="0"
                hidden={i !== 0}
              >
                <p>Panel for {name.toLowerCase()}.</p>
              </div>
            ))}
          </rk-tabs>
        </Specimen>
      )
    })
  }
</SpecimenRow>

{
  [
    { title: 'The join', specimens: JOINS },
    { title: 'States', specimens: STATES },
  ].map((row) => (
    <SpecimenRow title={row.title}>
      {row.specimens.map((specimen) => (
        <Specimen label={specimen.label}>
          <div class:list={['rk-folder', { 'rk-folder--tinted': specimen.tinted }]}>
            <div class="rk-folder-tabs rk-scroll" role="tablist" aria-label="Specimen">
              {STATIC_TABS.map((name, i) => (
                <button
                  class:list={['rk-folder-tab', specimen.state?.tab === i && specimen.state.class]}
                  type="button"
                  role="tab"
                  aria-selected={i === specimen.selected ? 'true' : 'false'}
                  tabindex={i === specimen.selected ? undefined : -1}
                >
                  {name}
                </button>
              ))}
            </div>
            <div class="rk-folder-sheet" role="tabpanel">
              <p>Panel.</p>
            </div>
          </div>
        </Specimen>
      ))}
    </SpecimenRow>
  ))
}

<style>
  .rk-folder-sheet p {
    margin: 0;
  }
</style>

<script>
  import 'rk-ui/folder-scrollbar.js'
  import 'rk-ui/tabs.js'
</script>
