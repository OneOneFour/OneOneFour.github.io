---
/** rk-ui's back-to-top link, an icon button for the end of an `.rk-topbar`. */
import ArrowUp from 'rk-ui/icons/arrow-up.svg'
import Button from './ui/Button.astro'
---

<Button href="#top" class="rk-back-to-top">
  <ArrowUp class="rk-icon" aria-hidden="true" />
  <span class="rk-visually-hidden">Back to top</span>
</Button>
