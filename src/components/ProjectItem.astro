---
// Ported from the old Vue ProjectItem.vue. The original tracked a
// `mouseOver` boolean in JS and used a <transition> to slide the overlay in
// on mouseenter/mouseleave --- that's exactly what CSS :hover + transition
// already does natively, so this is now a static Astro component with a
// CSS-only hover reveal instead of a Vue island. Every project also now
// gets a real detail page (no more directLink bypass --- see
// src/content.config.ts), so the "View" button always links to /project/[slug].
import ProjectIcons from './ProjectIcons.astro'

const MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec']
const monthStr = (m: number) => MONTHS[m - 1] ?? ''

const { project } = Astro.props
const { title, tagline, tech, year, month, startYear, startMonth, image } = project.data

const endDate = `${monthStr(month)} ${year}`
const startDate = startYear ? `${monthStr(startMonth)} ${startYear} - ` : ''
const backgroundImage = image ?? '/blank.png'
---

<div class="project-item" style={{ backgroundImage: `url(${backgroundImage})` }}>
  <div class="project-item-content">
    <h3 class="project-item-title">{title}</h3>
    {startDate}{endDate}
    <p class="project-item-tagline">{tagline}</p>
    <div class="project-item-footer">
      <a class="project-item-link" href={`/project/${project.id}`}>View</a>
      <ProjectIcons tech={tech} />
    </div>
  </div>
</div>

<style>
  .project-item {
    margin: 1rem;
    flex: 0 0 auto;
    width: 280px;
    height: 200px;
    background-size: cover;
    overflow: hidden;
    position: relative;
    background-position: center;
  }
  .project-item-content {
    background-color: rgba(255, 255, 255, 0.3);
    color: var(--color-text);
    width: 100%;
    height: 100%;
    position: absolute;
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: space-around;
    padding: 5px 15px;
    /* CSS-only equivalent of the old mouseOver + <transition name="slide"> */
    opacity: 0;
    transform: translateY(100%);
    transition: opacity 0.25s ease, transform 0.25s ease;
  }
  .project-item:hover .project-item-content {
    opacity: 1;
    transform: translateY(0);
  }
  .project-item-tagline {
    font-size: 10pt;
  }
  .project-item-title {
    font-weight: 700;
    text-align: left;
  }
  .project-item-link {
    border: 4px solid var(--color-border);
    color: var(--color-text);
    font-weight: 600;
    padding: 5px;
    border-radius: 50px;
  }
  .project-item-link:hover {
    color: var(--color-bg);
    background-color: var(--color-border);
  }
  .project-item-footer {
    width: 100%;
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
  }
</style>
