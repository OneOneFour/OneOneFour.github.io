---
// Ported from the old Vue ProjectImages.vue. The original used Vue purely
// for a `currentImg` index and a click handler --- that's simple enough to
// do with a few lines of plain JS in a <script> tag below, so there's no
// need to pull in Vue (or any framework) just for an image slideshow.
interface Props {
  imageUrls: string[]
  autoScrollMs?: number // 0 disables auto-advance, matching the old default
}

const { imageUrls, autoScrollMs = 0 } = Astro.props
const showButtons = imageUrls.length > 1
---

<div class="project-detail-item project-images-container" data-autoscroll={autoScrollMs}>
  <div class="project-images">
    {showButtons && (
      <button class="toggle-switch-pi" data-dir="1" aria-label="Next image">
        <img src="/icons/arrow-64.svg" alt="" />
      </button>
    )}
    <div class="img-holder">
      {imageUrls.map((url, i) => (
        <img src={url} data-slide-index={i} style={{ display: i === 0 ? 'block' : 'none' }} alt="" />
      ))}
    </div>
    {showButtons && (
      <button class="toggle-switch-pi" data-dir="-1" aria-label="Previous image">
        <img src="/icons/arrow-25.svg" alt="" />
      </button>
    )}
  </div>
</div>

<style>
  .project-images-container {
    grid-row: 2 / 3;
    grid-column: 1 / 2;
    align-self: center;
    height: 100%;
  }
  .toggle-switch-pi {
    background-color: var(--color-bg);
    border: 4px solid var(--color-border);
    color: var(--color-text);
    border-radius: 30px;
    padding: 6px;
    text-align: center;
    cursor: pointer;
    height: 32px;
    width: 32px;
  }
  .toggle-switch-pi:focus {
    outline: none;
  }
  .toggle-switch-pi:hover {
    background-color: var(--color-border);
  }
  .toggle-switch-pi:hover > img {
    filter: invert(100%);
  }
  .project-images {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0 15px;
    height: 100%;
  }
  .project-images > .img-holder {
    flex: 1 1 auto;
  }
  .img-holder {
    text-align: center;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .img-holder img {
    max-width: 95%;
    max-height: 95%;
  }
</style>

<script>
  // @ts-nocheck --- plain DOM script, not worth typing.
  // Runs once for the whole page; handles every .project-images-container
  // on it (there's normally just one, on a project detail page).
  document.querySelectorAll('.project-images-container').forEach((container) => {
    const images = Array.from(container.querySelectorAll('.img-holder img'))
    if (images.length <= 1) return

    let current = 0
    const show = (next) => {
      images[current].style.display = 'none'
      current = ((next % images.length) + images.length) % images.length
      images[current].style.display = 'block'
    }

    container.querySelectorAll('button[data-dir]').forEach((btn) => {
      btn.addEventListener('click', () => show(current + Number(btn.dataset.dir)))
    })

    const autoScrollMs = Number(container.dataset.autoscroll)
    if (autoScrollMs > 0) {
      setInterval(() => show(current + 1), autoScrollMs)
    }
  })
</script>
