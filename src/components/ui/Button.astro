---
/**
 * An rk-ui button, or a link styled as one when `href` is given. Put an icon before the label in
 * the slot. Other attributes pass through: <a> ones for a link, <button> ones otherwise.
 *
 * @param fill the fill colour; yellow when left out
 * @param unfilled the outline-only secondary style
 * @param small the small size
 * @param href renders an <a> instead of a <button>
 */
import type { HTMLAttributes } from 'astro/types'

type Fill = 'navy' | 'teal' | 'green' | 'coral' | 'grape' | 'tangerine' | 'section'

interface Style {
  fill?: Fill
  unfilled?: boolean
  small?: boolean
}

type LinkProps = Style & HTMLAttributes<'a'> & { href: string }
type ButtonProps = Style & HTMLAttributes<'button'> & { href?: never }
type Props = LinkProps | ButtonProps

const { fill, unfilled = false, small = false, class: className, ...attrs } = Astro.props
const classes = [
  'rk-button',
  fill && `rk-button--${fill}`,
  { 'rk-button--unfilled': unfilled, 'rk-button--small': small },
  className,
]
---

{
  attrs.href === undefined ? (
    <button type="button" class:list={classes} {...attrs}>
      <slot />
    </button>
  ) : (
    <a class:list={classes} {...attrs}>
      <slot />
    </a>
  )
}
