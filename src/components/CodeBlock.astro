---
/**
 * A highlighted code block: rk-ui's code-block markup around Astro's <Code>, with the syntax
 * colours taken from the --code-* tokens.
 *
 * @param code the source to show
 * @param lang the Shiki language id, e.g. "python"
 * @param label the language name shown in the caption, after the language's logo if it has one;
 *   leave it out for no caption
 * @param class extra classes for the figure, e.g. a box variant
 */
import { Code } from 'astro:components'
import type { ComponentProps } from 'astro/types'
import CopyIcon from 'rk-ui/icons/copy.svg'
import JsonLogo from '../icons/brands/languages/json.svg'
import JuliaLogo from '../icons/brands/languages/julia.svg'
import LatexLogo from '../icons/brands/languages/latex.svg'
import PythonLogo from '../icons/brands/languages/python.svg'
import RustLogo from '../icons/brands/languages/rust.svg'

interface Props {
  code: string
  lang: Extract<ComponentProps<typeof Code>['lang'], string>
  label?: string
  class?: string
}

/** Logos by Shiki language id or common alias. */
const LOGOS: Record<string, typeof PythonLogo> = {
  json: JsonLogo,
  julia: JuliaLogo,
  jl: JuliaLogo,
  latex: LatexLogo,
  python: PythonLogo,
  py: PythonLogo,
  rust: RustLogo,
  rs: RustLogo,
}

/** Python's logo keeps the caption colour: the PSF asks for permission before recolouring it. */
const FLAT_LOGOS = ['python', 'py']

const { code, lang, label, class: className } = Astro.props
const Logo = LOGOS[lang]
const accented = !FLAT_LOGOS.includes(lang)
---

<rk-code-block>
  <figure class:list={['rk-code', className]}>
    {
      label && (
        <figcaption class="rk-code-header">
          <span class:list={['rk-code-lang', { accented }]}>
            {Logo && <Logo class="rk-icon rk-icon--small" aria-hidden="true" />}
            {label}
          </span>
        </figcaption>
      )
    }
    <Code code={code} lang={lang} theme="css-variables" />
    <button type="button" class="rk-button rk-button--small rk-code-copy" hidden>
      <CopyIcon class="rk-icon rk-icon--small" />
      <span class="rk-code-copy-label">Copy</span>
    </button>
  </figure>
</rk-code-block>

<style>
  /* Astro's css-variables theme colours each token with var(--astro-code-*). */
  .rk-code {
    --astro-code-foreground: var(--fg);
    --astro-code-background: transparent;
    --astro-code-token-keyword: var(--code-keyword);
    --astro-code-token-function: var(--code-function);
    --astro-code-token-string: var(--code-string);
    --astro-code-token-string-expression: var(--code-string);
    --astro-code-token-constant: var(--code-number);
    --astro-code-token-comment: var(--code-comment);
    --astro-code-token-parameter: var(--fg);
    --astro-code-token-punctuation: var(--fg);
    --astro-code-token-link: var(--navy-deep);
  }

  .accented {
    --code-lang-color: var(--coral-deep);
  }
</style>

<script>
  import 'rk-ui/code-block.js'
</script>
