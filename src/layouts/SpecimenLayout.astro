---
// KaTeX's stylesheet comes first, so rk-ui's maths styles win.
import 'katex/dist/katex.min.css'
import 'rk-ui/rk-ui.css'
import themeInit from 'rk-ui/theme-init.js?raw'
import ThemeToggle from '../components/ThemeToggle.astro'
import PaletteSwitcher from '../components/styleguide/PaletteSwitcher.astro'
import ShadowSwitcher from '../components/styleguide/ShadowSwitcher.astro'

interface Props {
  title: string
}

const { title } = Astro.props
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <script is:inline set:html={themeInit} />
    <script is:inline>
      // Inline, like the theme, so a stored palette or shadow mode doesn't flash the default first.
      try {
        const palette = localStorage.getItem('rk-palette')
        if (palette) document.documentElement.dataset.palette = palette
        const shadow = localStorage.getItem('rk-shadow')
        if (shadow) document.documentElement.dataset.shadow = shadow
      } catch {
        // Storage is blocked, so the page keeps the defaults.
      }
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <title>{title}</title>
  </head>
  <body>
    <header class="specimen-header">
      <ShadowSwitcher />
      <PaletteSwitcher />
      <ThemeToggle />
    </header>
    <slot />
  </body>
</html>

<style>
  .specimen-header {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: var(--space-3);
    max-width: 96rem;
    margin-inline: auto;
    padding: var(--space-4) var(--space-4) 0;
  }
</style>
