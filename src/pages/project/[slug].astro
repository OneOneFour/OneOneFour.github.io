---
// Replaces the old Nuxt dynamic route pages/project/_name.vue. That page
// fetched project JSON + a separate markdown file at request time via
// $content(); here both metadata and body come from one content-collection
// entry, resolved at build time via getStaticPaths.
import { render } from 'astro:content'
import { getPublished } from '../../lib/content'
import Layout from '../../layouts/Layout.astro'
import ProjectIcons from '../../components/ProjectIcons.astro'
import ProjectLinks from '../../components/ProjectLinks.astro'
import ProjectImages from '../../components/ProjectImages.astro'

export async function getStaticPaths() {
  const projects = await getPublished('projects')
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }))
}

const { project } = Astro.props
const { title, tagline, tech, links, slideshow } = project.data
const { Content } = await render(project)
---

<Layout title={`${title} --- Robert King`} description={tagline}>
  <div class="container project-detail">
    <div class="bar">
      <h1 class="project-logo"><a href="/">Robert <span>King</span></a></h1>
      <div class="titlebox">
        <h1 class="project-name">{title}</h1>
        <h4 class="project-tagline">{tagline}</h4>
      </div>
      <ProjectIcons tech={tech} />
    </div>

    <ProjectLinks links={links} />

    <div class="link-description project-detail-item">
      <h2 class="description-title">description</h2>
      <div class="description-content">
        <Content />
      </div>
    </div>

    {slideshow.length > 0 && <ProjectImages imageUrls={slideshow} />}
  </div>
</Layout>

<style>
  .container {
    width: 1580px;
    margin: 0 auto;
    /* Needed (not just min-height, which global.css already sets for the
       homepage) so the grid-template-rows `fr` units below have a definite
       height to divide up --- otherwise the image row grows to fit its
       content and pushes .project-links off-screen. */
    height: 100vh;
  }
  .link-description {
    grid-row: 2 / 4;
  }
  .project-detail {
    display: grid;
    grid-template-columns: 65% 35%;
    grid-template-rows: 110px minmax(0, 4fr) 1fr;
  }
  .description-content {
    overflow: auto;
    height: 90%;
    font-size: 12pt;
  }
  .project-detail-item {
    padding: 15px 0;
    position: relative;
  }
  .project-detail-item h2 {
    margin-bottom: 15px;
  }
  .project-logo {
    font-weight: 600;
    line-height: 0.9;
    font-size: 25pt;
    border-right: 7px solid var(--color-border);
    padding-right: 10px;
  }
  .project-logo span {
    display: block;
  }
  .project-tagline {
    font-weight: 400;
    font-size: 11pt;
  }
  .titlebox {
    padding-left: 10px;
    flex: 1 1 auto;
  }
  .bar {
    grid-column: 1 / 3;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    padding: 30px 0 10px 0;
  }
  @media screen and (max-width: 1580px) {
    .container {
      width: 1240px;
    }
  }
  @media screen and (max-width: 1240px) {
    .container {
      width: 920px;
    }
  }
  @media screen and (max-width: 970px) {
    .container {
      width: 700px;
    }
  }
  @media screen and (max-width: 740px) {
    .container {
      width: 100%;
    }
    .project-detail {
      display: flex;
      flex-direction: column;
      align-items: center;
      padding: 0 30px;
    }
    .project-detail :global(.project-images-container) {
      order: 1;
    }
    .project-detail :global(.project-links) {
      order: 2;
      width: 100%;
    }
    .link-description {
      order: 3;
    }
    .description-content {
      overflow: visible;
    }
  }
</style>
