---
import SpecimenLayout from '../../layouts/SpecimenLayout.astro'
import SpecimenSection from '../../components/styleguide/SpecimenSection.astro'
import ColourTokens from '../../components/styleguide/ColourTokens.astro'
import HueVariants from '../../components/styleguide/HueVariants.astro'
import TypeScale from '../../components/styleguide/TypeScale.astro'
import FontSpecimens from '../../components/styleguide/FontSpecimens.astro'
import MonoCandidates from '../../components/styleguide/MonoCandidates.astro'
---

<SpecimenLayout title="Styleguide">
  <main>
    <h1>Styleguide</h1>

    <SpecimenSection title="Colour tokens">
      <p>Ratios are WCAG contrast: AA needs 4.5 for body text, 3:1 for large text and UI edges.</p>
      <ColourTokens slot="light" theme="light" />
      <ColourTokens slot="dark" theme="dark" />
    </SpecimenSection>

    <SpecimenSection title="Hue variants to choose">
      <p>
        Reply with one option per token, e.g. “teal-deep alt2”. For -deep, alt1 is closest to the
        vivid hue and alt2 is darker in light mode and paler in dark mode. For -tint, alt1 is
        quieter and alt2 has a stronger hue.
      </p>
      <HueVariants slot="light" theme="light" />
      <HueVariants slot="dark" theme="dark" />
    </SpecimenSection>

    <SpecimenSection title="Type scale" stacked>
      <p>Reply with a ratio: 1.2, 1.25 or 1.333.</p>
      <TypeScale slot="light" />
      <TypeScale slot="dark" />
    </SpecimenSection>

    <SpecimenSection title="Fonts">
      <FontSpecimens slot="light" />
      <FontSpecimens slot="dark" />
    </SpecimenSection>

    <SpecimenSection title="Monospace candidates" stacked>
      <p>Reply with JetBrains Mono or Roboto Mono.</p>
      <MonoCandidates slot="light" />
      <MonoCandidates slot="dark" />
    </SpecimenSection>
  </main>
</SpecimenLayout>

<style>
  main {
    max-width: 96rem;
    margin-inline: auto;
    padding: var(--space-6) var(--space-4);
  }
</style>
