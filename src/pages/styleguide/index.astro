---
import SpecimenLayout from '../../layouts/SpecimenLayout.astro'
// After SpecimenLayout, which loads rk-ui.css, so the mirrored states win over the real ones.
import '../../components/styleguide/states.css'
import SpecimenSection from '../../components/styleguide/SpecimenSection.astro'
import ColourSummary from '../../components/styleguide/ColourSummary.astro'
import ColourTokens from '../../components/styleguide/ColourTokens.astro'
import TypeScale from '../../components/styleguide/TypeScale.astro'
import FontSpecimens from '../../components/styleguide/FontSpecimens.astro'
import CodeSpecimens from '../../components/styleguide/CodeSpecimens.astro'
import ShapeSpecimens from '../../components/styleguide/ShapeSpecimens.astro'
import MotionSpecimens from '../../components/styleguide/MotionSpecimens.astro'
import LightDirection from '../../components/styleguide/LightDirection.astro'
import ShadowSpecimens from '../../components/styleguide/ShadowSpecimens.astro'
import DepthSpecimens from '../../components/styleguide/DepthSpecimens.astro'
import BaseSpecimens from '../../components/styleguide/BaseSpecimens.astro'
import IconSpecimens from '../../components/styleguide/IconSpecimens.astro'
import ButtonSpecimens from '../../components/styleguide/ButtonSpecimens.astro'
import InputSpecimens from '../../components/styleguide/InputSpecimens.astro'
import SpecialInputSpecimens from '../../components/styleguide/SpecialInputSpecimens.astro'
import SelectPickerSpecimens from '../../components/styleguide/SelectPickerSpecimens.astro'
import DialSpecimens from '../../components/styleguide/DialSpecimens.astro'
import ClockSpecimens from '../../components/styleguide/ClockSpecimens.astro'
import ChoiceSpecimens from '../../components/styleguide/ChoiceSpecimens.astro'
import RangeSpecimens from '../../components/styleguide/RangeSpecimens.astro'
import SegmentedSpecimens from '../../components/styleguide/SegmentedSpecimens.astro'
import TileSpecimens from '../../components/styleguide/TileSpecimens.astro'
import BallotSpecimens from '../../components/styleguide/BallotSpecimens.astro'
import ChipSpecimens from '../../components/styleguide/ChipSpecimens.astro'
import CardSpecimens from '../../components/styleguide/CardSpecimens.astro'
import CalloutSpecimens from '../../components/styleguide/CalloutSpecimens.astro'
import BadgeSpecimens from '../../components/styleguide/BadgeSpecimens.astro'
import LoadingSpecimens from '../../components/styleguide/LoadingSpecimens.astro'
import TooltipSpecimens from '../../components/styleguide/TooltipSpecimens.astro'
import WidgetFrameSpecimen from '../../components/styleguide/WidgetFrameSpecimen.astro'
import BreadcrumbSpecimens from '../../components/styleguide/BreadcrumbSpecimens.astro'
import FolderSpecimens from '../../components/styleguide/FolderSpecimens.astro'
import PaginationSpecimens from '../../components/styleguide/PaginationSpecimens.astro'
import TopBarSpecimens from '../../components/styleguide/TopBarSpecimens.astro'
import OverflowSpecimens from '../../components/styleguide/OverflowSpecimens.astro'
import EquationSpecimens from '../../components/styleguide/EquationSpecimens.astro'
import MathsInTextSpecimens from '../../components/styleguide/MathsInTextSpecimens.astro'
import ChartPaletteSpecimens from '../../components/styleguide/ChartPaletteSpecimens.astro'
import ChartSpecimens from '../../components/styleguide/ChartSpecimens.astro'
import DiagramSpecimens from '../../components/styleguide/DiagramSpecimens.astro'
import FigureSpecimens from '../../components/styleguide/FigureSpecimens.astro'
import StickyNoteSpecimens from '../../components/styleguide/StickyNoteSpecimens.astro'
import ExplodedViewSpecimens from '../../components/styleguide/ExplodedViewSpecimens.astro'
import StyleguideContents from '../../components/styleguide/StyleguideContents.astro'

const CONTENTS = [
  {
    title: 'Foundations',
    sections: ['Colours', 'Type', 'Fonts', 'Icons', 'Shape, shadow and depth', 'Motion'],
  },
  {
    title: 'Controls',
    sections: [
      'Buttons',
      'Text inputs and selects',
      'Custom select list',
      'Special inputs',
      'Checkboxes, radios and switches',
      'Range slider',
      'Dial',
      'Clock',
      'Segmented control',
      'Tile and colour pickers',
      'Ballot',
      'Chips',
    ],
  },
  {
    title: 'Components',
    sections: ['Cards', 'Callouts', 'Sticky notes', 'Code blocks', 'Widget frame'],
  },
  {
    title: 'Feedback',
    sections: ['Loading', 'Tooltips and popups', 'Badges'],
  },
  {
    title: 'Navigation and scrolling',
    sections: ['Breadcrumbs', 'Folder tabs', 'Pagination', 'Top bar', 'Overflow'],
  },
  {
    title: 'Maths and charts',
    sections: ['Equations', 'Maths in text', 'Chart colours', 'Charts', 'Diagrams', 'Figures and widgets'],
  },
  {
    title: 'Fun elements',
    sections: ['Exploded view'],
  },
]
---

<SpecimenLayout title="Styleguide">
  <main>
    <h1>Styleguide</h1>
    <StyleguideContents groups={CONTENTS} />

    <SpecimenSection title="Colours" collapsed="All colour tokens">
      <p>Ratios are WCAG contrast: AA needs 4.5 for body text, 3:1 for large text and UI edges.</p>
      <ColourSummary />
      <ColourTokens slot="light" theme="light" />
      <ColourTokens slot="dark" theme="dark" />
    </SpecimenSection>

    <SpecimenSection title="Type">
      <p>The type scale, then what base.css gives links, code, highlights and selections.</p>
      <Fragment slot="light"><TypeScale /><BaseSpecimens /></Fragment>
      <Fragment slot="dark"><TypeScale /><BaseSpecimens /></Fragment>
    </SpecimenSection>

    <SpecimenSection title="Fonts">
      <FontSpecimens slot="light" />
      <FontSpecimens slot="dark" />
    </SpecimenSection>

    <SpecimenSection title="Icons">
      <IconSpecimens slot="light" />
      <IconSpecimens slot="dark" />
    </SpecimenSection>

    <SpecimenSection title="Shape, shadow and depth" stacked>
      <p>The light turns every shadow and pop on the page.</p>
      <LightDirection />
      <p>
        Dark mode has two shadow modes: the slab by default, or data-shadow="colour" on &lt;html&gt;
        or any container, where each fill casts its own shade. The switch at the top sets it for the
        whole page, so every component can be seen in both. Light mode is the same in both.
      </p>
      <p>
        With data-depth="deep" on &lt;html&gt;, any container or one element, its shadows, insets and
        pops are 1.5 times as deep; data-depth="normal" switches back inside it.
      </p>
      <Fragment slot="light">
        <ShapeSpecimens />
        <ShadowSpecimens theme="light" />
        <DepthSpecimens theme="light" />
      </Fragment>
      <Fragment slot="dark">
        <ShapeSpecimens />
        <ShadowSpecimens theme="dark" />
        <DepthSpecimens theme="dark" />
      </Fragment>
    </SpecimenSection>

    <SpecimenSection title="Motion">
      <p>
        The patterns of the motion policy (PLAN §5.7). Turn the light under Shape, shadow and depth to
        see the shadows and the glint follow it while things move.
      </p>
      <MotionSpecimens slot="light" />
      <MotionSpecimens slot="dark" />
    </SpecimenSection>

    <SpecimenSection title="Buttons">
      <ButtonSpecimens slot="light" />
      <ButtonSpecimens slot="dark" />
    </SpecimenSection>

    <SpecimenSection title="Text inputs and selects">
      <InputSpecimens slot="light" theme="light" />
      <InputSpecimens slot="dark" theme="dark" />
    </SpecimenSection>

    <SpecimenSection title="Custom select list">
      <p>
        Open these in a browser with customizable select (appearance: base-select) to see the
        styled list. Elsewhere they are the plain select above.
      </p>
      <SelectPickerSpecimens slot="light" theme="light" />
      <SelectPickerSpecimens slot="dark" theme="dark" />
    </SpecimenSection>

    <SpecimenSection title="Special inputs">
      <SpecialInputSpecimens slot="light" theme="light" />
      <SpecialInputSpecimens slot="dark" theme="dark" />
    </SpecimenSection>

    <SpecimenSection title="Checkboxes, radios and switches">
      <ChoiceSpecimens slot="light" theme="light" />
      <ChoiceSpecimens slot="dark" theme="dark" />
    </SpecimenSection>

    <SpecimenSection title="Range slider">
      <RangeSpecimens slot="light" theme="light" />
      <RangeSpecimens slot="dark" theme="dark" />
    </SpecimenSection>

    <SpecimenSection title="Dial">
      <p>
        Each dial draws over a native range input, which stays the accessible control: it keeps
        focus, the arrow keys, Home and End, Page Up and Page Down, and form submission. Add
        rk-dial--ramp to either dial for a ring of blocks that light up to the value in token colours.
      </p>
      <DialSpecimens slot="light" theme="light" />
      <DialSpecimens slot="dark" theme="dark" />
    </SpecimenSection>

    <SpecimenSection title="Clock">
      <p>
        Drag a hand's tag to set the time: the hour hand goes round once a day, on a ring with day
        over the top and night under it. The time input below the face stays the control for the
        keyboard and screen readers.
      </p>
      <ClockSpecimens slot="light" theme="light" />
      <ClockSpecimens slot="dark" theme="dark" />
    </SpecimenSection>

    <SpecimenSection title="Segmented control">
      <SegmentedSpecimens slot="light" theme="light" />
      <SegmentedSpecimens slot="dark" theme="dark" />
    </SpecimenSection>

    <SpecimenSection title="Tile and colour pickers">
      <TileSpecimens slot="light" theme="light" />
      <TileSpecimens slot="dark" theme="dark" />
    </SpecimenSection>

    <SpecimenSection title="Ballot">
      <BallotSpecimens slot="light" theme="light" />
      <BallotSpecimens slot="dark" theme="dark" />
    </SpecimenSection>

    <SpecimenSection title="Chips">
      <ChipSpecimens slot="light" theme="light" />
      <ChipSpecimens slot="dark" theme="dark" />
    </SpecimenSection>

    <SpecimenSection title="Cards">
      <CardSpecimens slot="light" />
      <CardSpecimens slot="dark" />
    </SpecimenSection>

    <SpecimenSection title="Callouts">
      <CalloutSpecimens slot="light" />
      <CalloutSpecimens slot="dark" />
    </SpecimenSection>

    <SpecimenSection title="Sticky notes">
      <p>
        Add .rk-sticky-note to a card or a callout. Turn the light under Shape, shadow and depth to
        see the tilted notes' shadows follow it.
      </p>
      <StickyNoteSpecimens slot="light" />
      <StickyNoteSpecimens slot="dark" />
    </SpecimenSection>

    <SpecimenSection title="Code blocks" stacked>
      <p>
        The copy buttons are live; without JavaScript they stay hidden. Tab into a block to scroll
        long lines with the arrow keys; Overflow shows a long line.
      </p>
      <CodeSpecimens slot="light" />
      <CodeSpecimens slot="dark" />
    </SpecimenSection>

    <SpecimenSection title="Widget frame">
      <WidgetFrameSpecimen slot="light" />
      <WidgetFrameSpecimen slot="dark" />
    </SpecimenSection>

    <SpecimenSection title="Loading">
      <LoadingSpecimens slot="light" />
      <LoadingSpecimens slot="dark" />
    </SpecimenSection>

    <SpecimenSection title="Tooltips and popups">
      <p>
        Popups open under their button where CSS anchor positioning is supported, and in the middle
        of the window elsewhere.
      </p>
      <TooltipSpecimens slot="light" theme="light" />
      <TooltipSpecimens slot="dark" theme="dark" />
    </SpecimenSection>

    <SpecimenSection title="Badges">
      <BadgeSpecimens slot="light" />
      <BadgeSpecimens slot="dark" />
    </SpecimenSection>

    <SpecimenSection title="Breadcrumbs">
      <BreadcrumbSpecimens slot="light" />
      <BreadcrumbSpecimens slot="dark" />
    </SpecimenSection>

    <SpecimenSection title="Folder tabs">
      <p>
        The live tabs follow the ARIA tabs pattern: click a tab, or focus one and use the arrow keys,
        Home and End.
      </p>
      <FolderSpecimens slot="light" theme="light" />
      <FolderSpecimens slot="dark" theme="dark" />
    </SpecimenSection>

    <SpecimenSection title="Pagination">
      <PaginationSpecimens slot="light" />
      <PaginationSpecimens slot="dark" />
    </SpecimenSection>

    <SpecimenSection title="Top bar">
      <p>
        Options for Gate 1b. This page's own header is A; see <a href="?topbar=flush">B live</a> here.
        At the top of the page the toast lies flat and the flush bar has no shadow; scroll a little
        and they take the look below, and the back-to-top button appears.
      </p>
      <TopBarSpecimens slot="light" />
      <TopBarSpecimens slot="dark" />
    </SpecimenSection>

    <SpecimenSection title="Overflow" stacked>
      <p>
        The dots show only on the side with more to see, and not at all when everything fits. Scroll,
        or tab into a block and use the arrow keys. The dots need scroll-driven animations; other
        browsers show the scrollbar at all times.
      </p>
      <OverflowSpecimens slot="light" />
      <OverflowSpecimens slot="dark" />
    </SpecimenSection>

    <SpecimenSection title="Equations" stacked>
      <p>
        Rendered by KaTeX at build time. Click a reference to jump to its equation.
      </p>
      <EquationSpecimens slot="light" theme="light" />
      <EquationSpecimens slot="dark" theme="dark" />
    </SpecimenSection>

    <SpecimenSection title="Maths in text" stacked>
      <MathsInTextSpecimens slot="light" theme="light" />
      <MathsInTextSpecimens slot="dark" theme="dark" />
    </SpecimenSection>

    <SpecimenSection title="Chart colours">
      <ChartPaletteSpecimens slot="light" />
      <ChartPaletteSpecimens slot="dark" />
    </SpecimenSection>

    <SpecimenSection title="Charts" stacked>
      <p>
        A vibe check, not part of rk-ui in this version: inline SVG drawn at build time, in the toon
        look and coloured by the styleguide's chart tokens. The heatmaps have options for Gate 1b.
      </p>
      <ChartSpecimens slot="light" />
      <ChartSpecimens slot="dark" />
    </SpecimenSection>

    <SpecimenSection title="Diagrams" stacked>
      <p>
        A vibe check like the charts: inline SVG in the toon look, animated by the motion policy
        (PLAN §5.7). Try them with the palette switch and the light.
      </p>
      <DiagramSpecimens slot="light" theme="light" />
      <DiagramSpecimens slot="dark" theme="dark" />
    </SpecimenSection>

    <SpecimenSection title="Figures and widgets" stacked>
      <FigureSpecimens slot="light" theme="light" />
      <FigureSpecimens slot="dark" theme="dark" />
    </SpecimenSection>

    <SpecimenSection title="Exploded view">
      <p>
        Illustrations made only of flat toon shapes, whose assemblies come apart on hover or focus.
        Each part says how far it moves and how many layers from the back it is. Try the light, the
        palettes and the shadow modes.
      </p>
      <ExplodedViewSpecimens slot="light" theme="light" />
      <ExplodedViewSpecimens slot="dark" theme="dark" />
    </SpecimenSection>
  </main>
</SpecimenLayout>

<style>
  main {
    max-width: 96rem;
    margin-inline: auto;
    padding: var(--space-6) var(--space-4);
  }
</style>
