---
import Layout from '../layouts/Layout.astro'
import ProjectGrid from '../components/ProjectGrid.astro'

// --- Edit these to change what shows up on the splash page ---------------

const socialLinks = [
  { label: 'GitHub', href: 'https://www.github.com/OneOneFour', icon: '/icons/github.svg' },
  { label: 'LinkedIn', href: 'https://www.linkedin.com/in/robert-king-8263b6140/', icon: '/icons/linkedin.svg' },
]

const email = 'robertcking98@gmail.com'

// Flip to true once /public/Robert_King_CV.pdf is the version you want linked.
const showCvLink = false
// ---------------------------------------------------------------------------
---

<Layout title="Robert King">
  <div class="container" id="app-container">
    <div class="leftbar" id="leftbar">
      <!-- Mobile only: this button and .mini-left-bar toggle between profile and projects. -->
      <button class="toggle-switch top" id="show-projects" aria-label="Show projects">
        <img src="/icons/arrow-66.svg" alt="" /><span>Projects</span>
      </button>

      <img src="/images/mugshota.png" alt="Photo of me (Rob that is)" class="photo">
      <h1 class="name">Robert King</h1>

      <div class="bio">
        <!-- EDIT YOUR BIO HERE --------------------------------------------- -->
        <p>Late stage graduate student in at Stanford University.</p>
        <p>Interested in predicting the future (particularly involving complicated things). </p>
        <p>Curator of climate models.</p>
        <p class="old">Former developer at Octopus Energy and GMV NSL.</p>

        <!-- ------------------------------------------------------------------ -->
      </div>

      <div class="links">
        <div class="social">
          {socialLinks.map((link) => (
            <a href={link.href} aria-label={link.label}>
              <img src={link.icon} alt={link.label} />
            </a>
          ))}
        </div>
        <a class="bubble" href={`mailto:${email}`}>
          <img src="/icons/email.svg" alt="Email" />
          <span>{email}</span>
        </a>


        {showCvLink && (
          <a class="bubble" href="/files/Robert_King_CV.pdf">
            <img src="/icons/cv.svg" alt="Download CV" />
            <span>Curriculum Vitae</span>
          </a>
        )}
      </div>
    </div>

    <button class="mini-left-bar" id="show-profile" hidden aria-label="Show profile">
      <h1 class="mini-left-bar-title">RK</h1>
      <img src="/icons/arrow-65.svg" alt="" />
    </button>

    <div class="rightbar" id="rightbar">
      <ProjectGrid />
    </div>
  </div>
</Layout>

<script>
  // @ts-nocheck
  // Mobile profile/projects toggle.
  const leftbar = document.getElementById('leftbar')
  const miniBar = document.getElementById('show-profile')
  const rightbar = document.getElementById('rightbar')

  const setPane = (showProjects) => {
    leftbar.hidden = showProjects
    miniBar.hidden = !showProjects
    rightbar.classList.toggle('fill', showProjects)
  }

  document.getElementById('show-projects')?.addEventListener('click', () => setPane(true))
  miniBar.addEventListener('click', () => setPane(false))
</script>
